generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MediaStatus {
  WATCHING
  COMPLETED
  PAUSED
  DROPPED
  PLANNING
  REWATCHING
  UPCOMING
}

enum MediaType {
  MOVIE
  TV_SEASON
}

model Entry {
  id             String      @id @default(cuid())
  tmdbId         Int         @unique
  parentTmdbId   Int?
  seasonNumber   Int?
  title          String
  type           MediaType
  status         MediaStatus @default(PLANNING)
  score          Float       @default(0)
  progress       Int         @default(0)
  totalEpisodes  Int?
  totalSeasons   Int?
  episodeRuntime Int?

  startDate    DateTime?
  finishDate   DateTime?
  rewatchCount Int       @default(0)

  synopsis         String?   @db.Text
  releaseDate      String?
  endDate          String?
  lastAirDate      String?
  format           String?
  rating           Float?
  popularity       Float?
  imagePath        String?
  bannerPath       String?
  logoPath         String?
  customImage      String?
  genres           String?
  studio           String?
  networks         String?
  languages        String?
  staff            Json?
  productionStatus String    @default("Released")
  lastSyncedAt     DateTime?

  notes          String? @db.Text
  private        Boolean @default(false)
  hidden         Boolean @default(false)
  hasNewEpisodes Boolean @default(false)

  isFavorite   Boolean @default(false)
  favoriteRank Int?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Relações corrigidas
  relationsFrom Relation[] @relation("SourceRelations")
  relationsTo   Relation[] @relation("TargetRelations")
  seasons       Season[]
  episodes      Episode[]
  syncLogs      SyncLog[]

  @@index([status])
  @@index([type])
  @@index([tmdbId])
  @@index([parentTmdbId])
  @@index([isFavorite])
  @@index([productionStatus])
  @@index([lastSyncedAt])
}

model PosterChoice {
  id                 String   @id @default(cuid())
  key                String   @unique
  mediaType          String
  tmdbId             Int
  seasonNumber       Int?
  title              String?
  posterPath         String
  officialPosterPath String?
  source             String   @default("tmdb")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([mediaType, tmdbId])
  @@index([key])
}

model Relation {
  id String @id @default(cuid())

  sourceEntryId String
  targetEntryId String?

  relationType String

  title           String
  poster_path     String?
  kind            String
  year            String?
  seasonNumber    Int?
  order           Int?
  isAutomatic     Boolean @default(false)
  sequenceOrder   Int?
  spinoffMetadata Json?

  targetTmdbId       Int
  targetParentTmdbId Int?
  targetSeasonNumber Int?
  targetType         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceEntry Entry  @relation("SourceRelations", fields: [sourceEntryId], references: [id], onDelete: Cascade)
  targetEntry Entry? @relation("TargetRelations", fields: [targetEntryId], references: [id], onDelete: SetNull)

  @@unique([sourceEntryId, targetTmdbId])
  @@index([sourceEntryId])
  @@index([targetEntryId])
  @@index([relationType])
}

model Profile {
  id          String   @id @default("main")
  username    String   @default("My Profile")
  bio         String?
  avatarUrl   String?
  bannerUrl   String?
  avatarColor String   @default("#3db4f2")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model UserGamification {
  id            String    @id @default(cuid())
  userId        String    @unique
  totalXP       Int       @default(0)
  currentLevel  Int       @default(1)
  xpToNextLevel Int       @default(1000)
  currentXP     Int       @default(0)
  badges        String[]  @default([])
  lastAwardedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([currentLevel])
  @@index([totalXP])
}

model GamificationActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  xpGained  Int
  metadata  Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
}

model StreakData {
  id              String    @id @default(cuid())
  userId          String    @unique
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastActivityDay DateTime?
  updatedAt       DateTime  @updatedAt
}

model UserChallenge {
  id           String    @id @default(cuid())
  userId       String
  challengeId  String
  periodKey    String
  category     String
  title        String
  description  String
  type         String
  difficulty   String
  goal         Int
  current      Int       @default(0)
  rewardXP     Int
  rewardBadge  String?
  metadata     Json      @default("{}")
  progressData Json      @default("{}")
  startsAt     DateTime
  expiresAt    DateTime
  completedAt  DateTime?
  claimedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, challengeId, periodKey])
  @@index([userId, category, periodKey])
  @@index([userId, completedAt])
  @@index([expiresAt])
}

model ChallengeCompletion {
  id          String   @id @default(cuid())
  userId      String
  challengeId String
  periodKey   String
  category    String
  title       String
  xpAwarded   Int
  badge       String?
  completedAt DateTime @default(now())

  @@unique([userId, challengeId, periodKey])
  @@index([userId, completedAt])
  @@index([challengeId, periodKey])
}

model ActivityLog {
  id            String   @id @default(cuid())
  entryId       String
  title         String
  imagePath     String?
  type          String
  status        String
  progressStart Int?
  progressEnd   Int?
  score         Float
  slug          String
  createdAt     DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt
}

model PersonalGoal {
  id          String    @id @default(cuid())
  userId      String    @default("main")
  title       String
  type        String
  target      Float
  current     Float     @default(0)
  unit        String    @default("")
  emoji       String    @default("🎯")
  deadline    DateTime?
  rewardXP    Int       @default(0)
  pinned      Boolean   @default(false)
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([completed])
}

model Season {
  id           String   @id @default(cuid())
  entryId      String
  tmdbId       Int?
  parentTmdbId Int
  seasonNumber Int
  title        String
  overview     String?  @db.Text
  posterPath   String?
  airDate      String?
  episodeCount Int      @default(0)
  status       String   @default("Unknown")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entry    Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@unique([entryId, seasonNumber])
  @@index([parentTmdbId])
  @@index([tmdbId])
  @@index([status])
}

model Episode {
  id            String    @id @default(cuid())
  entryId       String
  seasonId      String?
  tmdbId        Int?
  parentTmdbId  Int
  seasonNumber  Int
  episodeNumber Int
  title         String
  overview      String?   @db.Text
  stillPath     String?
  airDate       String?
  runtime       Int?
  watched       Boolean   @default(false)
  watchedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  entry  Entry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  season Season? @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([entryId, seasonNumber, episodeNumber])
  @@index([parentTmdbId, seasonNumber])
  @@index([tmdbId])
  @@index([watched])
}

model SyncLog {
  id            String   @id @default(cuid())
  entryId       String
  changedFields String[] @default([])
  status        String
  errorMessage  String?  @db.Text
  syncedAt      DateTime @default(now())

  entry Entry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, syncedAt])
  @@index([status])
}
